# Servidor
PORT=3000
NODE_ENV=development

# Use um segredo aleatório com pelo menos 32 caracteres em produção.
# Exemplo para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Em desenvolvimento local, use false. Em produção com HTTPS, use true.
COOKIE_SECURE=false

# Use 1 somente quando existir um proxy reverso confiável (Nginx, Caddy, etc.).
TRUST_PROXY=0

# Banco local. O caminho padrão é ./data/agenda.sqlite
DATABASE_PATH=./data/agenda.sqlite

# E-mail (opcional). Sem estas variáveis, os agendamentos continuam funcionando,
# mas o envio automático fica indisponível.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agenda Italia <agenda@seudominio.com>"

# Desative somente em testes ou quando houver outro processo Sending reminders.
DISABLE_REMINDER_JOBS=false
